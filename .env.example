# ==============================================================================
# DeviceTry Environment Configuration
# ==============================================================================

# Application Mode: 'FREE_ONLY' (default) or 'PRO_ENABLED'
# - FREE_ONLY: All 8 browser hardware tests, guided inspections, printable reports,
#   and local history operate without any database, accounts, or Stripe credentials.
# - PRO_ENABLED: Enables subscriber accounts, Cloudflare D1 storage, Stripe checkout,
#   cloud inventory, custom branding, and billing portal.
NEXT_PUBLIC_APP_MODE=FREE_ONLY

# ------------------------------------------------------------------------------
# PRO_ENABLED Mode Requirements (Only required when NEXT_PUBLIC_APP_MODE=PRO_ENABLED)
# ------------------------------------------------------------------------------

# Application Base URL (e.g., https://devicetry.workers.dev or custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth session secret (at least 32 characters for secure token hashing)
AUTH_SESSION_SECRET=

# Stripe Billing Configuration ($9 USD/month Pro Plan)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
